{
  "name": "twoolkit-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "TwoolKit Desktop — Native macOS, Windows & Linux application built with Tauri 2 + Rust",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons:generate": "../backend/.venv/bin/python scripts/generate_icons.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
