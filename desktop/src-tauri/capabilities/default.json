{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Strict scoped capability set for the main TwoolKit Desktop window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://twoolkit.vercel.app",
      "https://twoolkit.vercel.app/*",
      "https://twoolkit.vercel.app/**",
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://localhost:3000/**",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:3000/**"
    ]
  },
  "permissions": [
    "core:default",
    "updater:default"
  ]
}
