<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: Outgoing & Incoming Local Network for TwoolKit Web & Local Processing -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- User-Selected File Read/Write via Native Open/Save Dialogs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- WebKit / JavaScriptCore JIT Required by Tauri WKWebView Under Hardened Runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
